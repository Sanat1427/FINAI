# ==============================================================================
# FinAI Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or any file containing real API keys to version control.
# ==============================================================================

# Google Gemini API
# Required for text embeddings (text-embedding-004) and Gemini 3.5 Flash generation
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alias (if using standard GOOGLE_API_KEY)
# GOOGLE_API_KEY=your_gemini_api_key_here

# Groq Cloud API
# Required for fast-path inference and direct circuit breaker fallback (qwen/qwen3.8-27b)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Configuration
# Required for authentication, vector storage (pgvector), and user documents
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
